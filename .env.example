# The workbench itself does not read secrets from this file.
# Put provider credentials in tradingagents-astock/.env, or export them in the shell.

# ASTOCK_TRADINGAGENTS_HOME=/absolute/path/to/tradingagents-astock
# ASTOCK_TRADINGAGENTS_PYTHON=/absolute/path/to/tradingagents-astock/.venv/bin/python

# Optional historical index turnover fallback (Tushare Pro, unit converted from 千元).
# ASTOCK_TUSHARE_TOKEN=your-tushare-token

# Choose the variables required by your TradingAgents provider, for example:
# MINIMAX_API_KEY=sk-...
# DEEPSEEK_API_KEY=sk-...
# DASHSCOPE_API_KEY=sk-...
# ZHIPU_API_KEY=...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
